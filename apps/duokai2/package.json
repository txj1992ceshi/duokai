{
  "name": "duokai2-desktop",
  "private": true,
  "version": "3.6.10",
  "description": "Duokai2 desktop app for local browser profile management and multi-environment testing.",
  "author": "jj",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --force",
    "clean": "rm -rf dist dist-electron release",
    "prepare:desktop-assets": "node scripts/prepare-desktop-assets.mjs && electron-builder install-app-deps",
    "build": "npm run prepare:desktop-assets && tsc -b && vite build && npm run verify:renderer-bundle && ELECTRON_BUILDER_CACHE=.cache/electron-builder CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -c electron-builder.config.cjs",
    "build:dir": "npm run prepare:desktop-assets && tsc -b && vite build && npm run verify:renderer-bundle && ELECTRON_BUILDER_CACHE=.cache/electron-builder CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -c electron-builder.config.cjs --dir",
    "build:mac": "npm run prepare:desktop-assets && tsc -b && vite build && npm run verify:renderer-bundle && ELECTRON_BUILDER_CACHE=.cache/electron-builder DUOKAI_ADHOC_SIGN=1 CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -c electron-builder.config.cjs --mac dmg zip --publish never",
    "build:win": "npm run prepare:desktop-assets && tsc -b && vite build && npm run verify:renderer-bundle && electron-builder -c electron-builder.config.cjs --win nsis zip --publish never",
    "build:mac:release": "npm run prepare:desktop-assets && tsc -b && vite build && npm run verify:renderer-bundle && ELECTRON_BUILDER_CACHE=.cache/electron-builder electron-builder -c electron-builder.release.config.cjs --mac dmg zip --publish never",
    "build:win:release": "npm run prepare:desktop-assets && tsc -b && vite build && npm run verify:renderer-bundle && electron-builder -c electron-builder.release.config.cjs --win nsis zip --publish never",
    "verify:renderer-bundle": "node scripts/verify-renderer-react-singleton.mjs",
    "smoke:win": "node scripts/run-desktop-smoke.mjs",
    "test:cloak-runtime": "node --test electron/services/hardwareProfiles.test.ts electron/services/machineIdentityPolicy.test.ts electron/services/profileMetadataBackfill.test.ts electron/services/environmentSyncMetadata.test.ts electron/services/environmentPushScope.test.ts electron/services/environmentPullIdempotence.test.ts electron/services/networkErrorRecovery.test.ts electron/services/runtimeScheduler.test.ts electron/services/runtimeContextLifecycle.test.ts electron/services/cloakBrowserIdentity.test.ts electron/services/cloakBrowserClientHints.test.ts electron/services/cloakBrowserRuntime.test.ts electron/services/cloakBrowserLiveness.test.ts electron/services/cloakBrowserPostTrustGate.test.ts electron/services/cloakBrowserFingerprint.test.ts electron/services/cloakBrowserNetwork.test.ts electron/services/cloakBrowserTrustedSnapshot.test.ts electron/services/cloakBrowserProductionIntegration.test.ts electron/services/referenceCountedAsyncResource.test.ts electron/services/proxyBridge.test.ts electron/services/cloakBrowserInstallPreflight.test.ts electron/services/cloakBrowserInstallationManager.test.ts electron/services/cloakBrowserSnapshotKeyLifecycle.test.ts electron/services/cloakBrowserTransactionRecovery.test.ts electron/services/cloakBrowserPilotGate.test.ts electron/services/cloakBrowserPilotConfig.test.ts electron/services/cloakBrowserProductionPilot.test.ts electron/services/cloakBrowserRolloutControl.test.ts electron/services/cloakBrowserCanaryRehearsal.test.ts electron/services/cloakBrowserSingleEnginePackaging.test.ts electron/services/cloakBrowserElectronCdpLaunch.test.ts electron/services/cloakBrowserStartupNavigation.test.ts electron/services/platformSmoke.test.ts electron/services/profileRuntimeMutationGate.test.ts electron/services/proxyFailureClassification.test.ts",
    "test:cloak-electron-cdp": "node --test electron/services/cloakBrowserElectronCdpLaunch.test.ts",
    "smoke:cloak-runtime": "node scripts/run-cloak-runtime-smoke.ts",
    "smoke:cloak-fingerprint": "node scripts/run-cloak-fingerprint-smoke.ts",
    "smoke:cloak-network": "node scripts/run-cloak-network-smoke.ts",
    "smoke:cloak-trusted-snapshot": "node scripts/run-cloak-trusted-snapshot-smoke.ts",
    "smoke:cloak-production-pilot": "node scripts/run-cloak-production-pilot-smoke.ts",
    "smoke:cloak-installation": "node scripts/run-cloak-installation-smoke.ts",
    "smoke:cloak-rollout-control": "node scripts/run-cloak-rollout-control-smoke.ts",
    "smoke:cloak-canary-rehearsal": "node scripts/run-cloak-canary-rehearsal-smoke.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:cloak-single-engine": "node --test electron/services/cloakBrowserSingleEnginePackaging.test.ts"
  },
  "dependencies": {
    "@duokai/ui": "file:../../packages/ui",
    "better-sqlite3": "^12.8.0",
    "cloakbrowser": "0.5.2",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.6.3",
    "i18next": "^25.1.3",
    "lucide-react": "^0.511.0",
    "playwright-core": "1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^15.5.2",
    "react-router-dom": "^7.13.1",
    "sonner": "^2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.jj.duokai2",
    "productName": "Duokai",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build-resources/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    }
  }
}
